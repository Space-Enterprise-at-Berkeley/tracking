import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os


script_dir = os.path.dirname(os.path.abspath(__file__))

aim_file = 'prospect_flight.csv'
grafana_file = 'Altitude_data.csv' # this is the same data that's from grafana

# LOADING DATA
try:
    aim_df = pd.read_csv(os.path.join(script_dir, aim_file), on_bad_lines='skip')
    graf_df = pd.read_csv(os.path.join(script_dir, grafana_file))
    print("Files loaded successfully!")
except FileNotFoundError as e:
    print(f"Error: {e}. Ensure CSVs are in {script_dir}")
    exit()

# DATA SYNCING & PHYSICS 
aim_launch_t = 650.5
graf_launch_t = 58.0
ground_alt = 639.0  # Ground level MSL

# Sync AIM Baro
aim_baro = aim_df[['time.3', 'Pressure AGL']].dropna()
aim_baro['T_rel'] = aim_baro['time.3'] - aim_launch_t

# Sync AIM GPS (Local SD Card Data)
# We assume the first GPS MSL reading is ground level
aim_gps = aim_df[['time.15', 'GPS MSL']].dropna()
aim_gps['T_rel'] = aim_gps['time.15'] - aim_launch_t
aim_gps['Alt_AGL'] = aim_gps['GPS MSL'] - aim_gps['GPS MSL'].iloc[0]

# Sync Grafana GPS (Radio Data)
graf_df = graf_df.drop_duplicates(subset=['Time'])
graf_df['Time_dt'] = pd.to_datetime(graf_df['Time'])
start_time = graf_df['Time_dt'].min()
graf_df['T_rel'] = (graf_df['Time_dt'] - start_time).dt.total_seconds() - graf_launch_t
graf_df['Alt_AGL'] = graf_df['fc1GpsValuesAltitude.mean'] - ground_alt

# Calculate Integrated IMU Displacement (Vertical X-axis)
accel_data = aim_df[['time', 'acceleration']].dropna()
g_bias = accel_data[accel_data['time'] < aim_launch_t]['acceleration'].mean()
flight = accel_data[accel_data['time'] >= aim_launch_t].copy()
flight['T_rel'] = flight['time'] - aim_launch_t
dt = flight['T_rel'].diff().fillna(0)

# Double integration: Accel -> Velocity -> Displacement
flight['v'] = ((flight['acceleration'] - g_bias) * 9.81 * dt).cumsum()
flight['dist'] = (flight['v'] * dt).cumsum()

# Generating graphs
fig, axs = plt.subplots(2, 2, figsize=(15, 10))
fig.suptitle('Task 1 & 2: Multi-Sensor Altitude Analysis', fontsize=16)

# Graph 1: Barometer
axs[0, 0].plot(aim_baro['T_rel'], aim_baro['Pressure AGL'], color='blue', label='Barometer (100Hz)')
axs[0, 0].set_title('1. Barometer (AIM SD)')
axs[0, 0].set_ylabel('Altitude (m)')
axs[0, 0].grid(True)

# Graph 2: AIM GPS (Local)
axs[0, 1].plot(aim_gps['T_rel'], aim_gps['Alt_AGL'], color='red', label='GPS (Internal)')
axs[0, 1].set_title('2. GPS (AIM SD)')
axs[0, 1].grid(True)

# Graph 3: Grafana GPS (Radio)
axs[1, 0].step(graf_df['T_rel'], graf_df['Alt_AGL'], where='post', color='orange', label='GPS (Radio)')
axs[1, 0].set_title('3. GPS (Grafana Radio)')
axs[1, 0].set_xlabel('Seconds Since Launch')
axs[1, 0].set_ylabel('Altitude (m)')
axs[1, 0].grid(True)

# Graph 4: Integrated IMU
axs[1, 1].plot(flight['T_rel'], flight['dist'], color='green', label='Integrated IMU')
axs[1, 1].set_title('4. Integrated Altitude (X-axis)')
axs[1, 1].set_xlabel('Seconds Since Launch')
axs[1, 1].grid(True)

# Formatting
for ax in axs.flat:
    ax.set_xlim(-5, 130)
    ax.set_ylim(-100, 3200)

plt.tight_layout(rect=[0, 0.03, 1, 0.95])
plt.savefig(os.path.join(script_dir, 'Full_Flight_Analysis_Dashboard.png'))
plt.show()