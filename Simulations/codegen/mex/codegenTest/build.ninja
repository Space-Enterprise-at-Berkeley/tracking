# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2025b
startdir = C:/Users/lenowo twinkpad/Documents/SEB/tracking/Simulations

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
cxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++
linker = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations\codegen\mex\codegenTest" -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations" -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations\codegen\mex\codegenTest\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=codegenTest_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations\codegen\mex\codegenTest" -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations" -I "C:\Users\lenowo twinkpad\Documents\SEB\tracking\Simulations\codegen\mex\codegenTest\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=codegenTest_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

ldflags = codegenTest.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "codegenTest_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

ldxxflags = codegenTest.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "codegenTest_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/codegenTest_data.o : cc $root/codegenTest_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/codegenTest_initialize.o : cc $root/codegenTest_initialize.c
build $builddir/codegenTest_terminate.o : cc $root/codegenTest_terminate.c
build $builddir/codegenTest.o : cc $root/codegenTest.c
build $builddir/validateattributes.o : cc $root/validateattributes.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/xnrm2.o : cc $root/xnrm2.c
build $builddir/KalmanFilter.o : cc $root/KalmanFilter.c
build $builddir/checkCovariance.o : cc $root/checkCovariance.c
build $builddir/anyNonFinite.o : cc $root/anyNonFinite.c
build $builddir/eigStandard.o : cc $root/eigStandard.c
build $builddir/trackingKF.o : cc $root/trackingKF.c
build $builddir/mtimes.o : cc $root/mtimes.c
build $builddir/qrsolve.o : cc $root/qrsolve.c
build $builddir/_coder_codegenTest_api.o : cc $root/interface/_coder_codegenTest_api.c
build $builddir/_coder_codegenTest_mex.o : cc $root/interface/_coder_codegenTest_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/xzlarfg.o : cc $root/xzlarfg.c
build $builddir/xzlascl.o : cc $root/xzlascl.c
build $builddir/xgemv.o : cc $root/xgemv.c
build $builddir/xgerc.o : cc $root/xgerc.c
build $builddir/xzlarf.o : cc $root/xzlarf.c
build $builddir/xhseqr.o : cc $root/xhseqr.c
build $builddir/xdlanv2.o : cc $root/xdlanv2.c
build $builddir/xzgebal.o : cc $root/xzgebal.c
build $builddir/xswap.o : cc $root/xswap.c
build $builddir/xdlahqr.o : cc $root/xdlahqr.c
build $builddir/mrdivide_helper.o : cc $root/mrdivide_helper.c
build $builddir/_coder_codegenTest_info.o : cc $root/interface/_coder_codegenTest_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\codegenTest_mex.mexw64 : link $builddir/codegenTest_data.o $builddir/rt_nonfinite.o $builddir/codegenTest_initialize.o $builddir/codegenTest_terminate.o $builddir/codegenTest.o $builddir/validateattributes.o $builddir/warning.o $builddir/xnrm2.o $builddir/KalmanFilter.o $builddir/checkCovariance.o $builddir/anyNonFinite.o $builddir/eigStandard.o $builddir/trackingKF.o $builddir/mtimes.o $builddir/qrsolve.o $builddir/_coder_codegenTest_api.o $builddir/_coder_codegenTest_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/xzlarfg.o $builddir/xzlascl.o $builddir/xgemv.o $builddir/xgerc.o $builddir/xzlarf.o $builddir/xhseqr.o $builddir/xdlanv2.o $builddir/xzgebal.o $builddir/xswap.o $builddir/xdlahqr.o $builddir/mrdivide_helper.o $builddir/_coder_codegenTest_info.o $builddir/c_mexapi_version.o 
